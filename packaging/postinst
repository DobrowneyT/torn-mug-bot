#!/bin/bash
# Runs on the server after files are unpacked: build the venv, seed .env, enable+start service.
set -e

INSTALL_DIR="/home/monchoon/torn/mug-bot"
RUN_USER="monchoon"
DATA_DIR="/var/lib/mug-bot"

# Persistent data dir (SQLite DB) — OUTSIDE the install dir so upgrades/reinstalls never wipe it.
mkdir -p "$DATA_DIR"
chown "$RUN_USER":"$RUN_USER" "$DATA_DIR"

# Build/refresh the virtualenv on the box (needs internet for pip).
if [ ! -d "$INSTALL_DIR/.venv" ]; then
    python3 -m venv "$INSTALL_DIR/.venv"
fi
"$INSTALL_DIR/.venv/bin/pip" install --quiet --upgrade pip
"$INSTALL_DIR/.venv/bin/pip" install --quiet -r "$INSTALL_DIR/requirements.txt"

# Seed .env from the example on first install only (never clobber an existing one).
if [ ! -f "$INSTALL_DIR/.env" ]; then
    cp "$INSTALL_DIR/.env.example" "$INSTALL_DIR/.env"
    echo "mug-bot: created $INSTALL_DIR/.env from the example."
    echo "mug-bot: EDIT it with your Discord token, channel ids and Torn/BSP keys, then:"
    echo "         sudo systemctl restart mug-bot"
fi

chown -R "$RUN_USER":"$RUN_USER" "$INSTALL_DIR"

systemctl daemon-reload
systemctl enable mug-bot.service
systemctl restart mug-bot.service || \
    echo "mug-bot: service did not start — likely .env is not filled in yet (check: journalctl -u mug-bot)."

exit 0
