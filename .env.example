# =============================================================================================
# Mug Bot configuration. Copy to .env and fill in. Only the Discord + Torn keys are required;
# everything else has a sensible default (shown as the value here) and can be left out.
# Most runtime knobs are also editable live via slash commands (/mugmin, /watch, /faction, /keys).
# =============================================================================================

# ---- Discord (its own bot app, separate from the OC Watcher) --------------------------------
MUG_BOT_DISCORD_TOKEN=your-bot-token-here
MUG_LOGS_CHANNEL_ID=000000000000000000      # mug alerts
MUG_STATUS_CHANNEL_ID=000000000000000000    # status panels (cache + per-category watch lists)
MUG_ITEMS_CHANNEL_ID=000000000000000000     # under-market deal alerts
# Scratch channel used only by scratch/format_preview.py to render mock embeds.
MUG_PREVIEW_CHANNEL_ID=000000000000000000
# Your server id (Developer Mode -> right-click server -> Copy Server ID) so slash commands
# register instantly in that guild (global registration can take up to an hour).
MUG_GUILD_ID=000000000000000000
# Optional roles to @ping at the top of each alert (right-click role -> Copy Role ID). 0 = no ping.
MUG_LOGS_ROLE_ID=0                           # pings on mug alerts
MUG_ITEMS_ROLE_ID=0                          # pings on deal alerts
# Friendly/avoid factions: a seller in one of these gets a "HOSPITALIZE — do NOT mug" alert.
# Comma-separated seed list; editable live with /faction add|remove|list (stored in the DB).
MUG_HOSPITALIZE_FACTION_IDS=                 # e.g. 12345,67890,...

# ---- Torn API ------------------------------------------------------------------------------
TORN_API_KEYS=key1,key2                      # comma-separated; also addable live via /keys add
BSP_API_KEY=your-bsp-key                     # optional (TBS via lol-manager fallback)
TORNSTATS_API_KEY=your-tornstats-key         # optional (TBS primary)
# Timeout for the BSP (lol-manager) TBS lookup. It sits on the alert path but TBS is display-only,
# so keep it short — a slow third party must not delay a mug alert. Torn's own calls use 15s.
MUG_BSP_TIMEOUT=3
# The `comment` shown to key owners in their API log for every call we make.
MUG_API_COMMENT=MonChoon Market Tracker

# ---- Server --------------------------------------------------------------------------------
MUG_SERVER_HOST=0.0.0.0
MUG_SERVER_PORT=3001
# SET THIS ON A SERVER. Defaults to /var/lib/mug-bot/mug_bot.db — outside the checkout, so a deploy,
# a re-clone or `git clean` can never touch your watch list / keys / captured data. If that directory
# isn't writable the bot falls back to a file NEXT TO THE CODE, i.e. inside the git working tree,
# where git can destroy it; it logs a warning when that happens. Blank is fine for local dev only.
# deploy/provision.sh creates /var/lib/mug-bot for you.
MUG_DB_PATH=

# ---- Detection mode ------------------------------------------------------------------------
# api : poll the item-market API (gear by uid + item-matcher sellers) — the safe default.
# ws  : the market-tracker WebSocket path.  both : run both into the shared pipeline.
MUG_DETECTION_MODE=api
# `both` sees each sale twice — the WS instantly, the poller a cache cycle later — with nothing
# joining the two observations, so each used to record its own row and the seller's window counted
# the item twice. A sale is now dropped if the OTHER detector recorded an equivalent one (same
# seller, item, unit price and quantity) within this many seconds. Same-path repeats are untouched:
# a seller genuinely selling two identical items must still count twice. 0 disables. Never consulted
# unless both detectors are live, so in `api` or `ws` mode this cannot fire.
MUG_SALE_DEDUP_SECONDS=180

# ---- API poller (gear + items) -------------------------------------------------------------
MUG_GEAR_POLL_INTERVAL=30                     # nominal cadence (s) for the calls/min estimate
# Adaptive cache-timed scheduling: each item is polled just after its NEXT cache snapshot is due.
# A snapshot is served ~30s stale and the next distinct one appears ~cache_timestamp+60, so we poll
# at cache_timestamp+OFFSET (62) to land just after it. RETRY re-checks if the snapshot was slow.
MUG_CACHE_REPOLL_OFFSET=62
MUG_CACHE_RETRY_SECONDS=3
MUG_POLL_TICK_SECONDS=1                       # scheduler granularity (how often due items are polled)
MUG_GEAR_VANISH_CONFIRM_POLLS=0              # absences before a uid = sold; 0/1 = fire on first (fastest)
MUG_GEAR_REQUIRE_RESEEN=false                # opt-in: require a uid be seen present >1 poll before a vanish counts (pairing is now dropped on vanish, so off by default)
MUG_MAX_CONCURRENT_POLLS=0                    # 0 = auto (= active key count); items polled in parallel
MUG_GEAR_BONUS_FILTER=Any                    # only fetch gear listings with a bonus ("" = all)
# Gear to poll with NO bonus filter (capture EVERY listing, e.g. melee that sells high without a
# bonus). Comma-separated category names (Primary/Secondary/Melee/Defensive) and/or item ids.
# Editable live via /gearbonus add|remove|list. e.g. MUG_GEAR_ALL_BONUS=Melee,146
MUG_GEAR_ALL_BONUS=
MUG_MAX_PAGES_GEAR=50                         # gear paginates fully (stops early at <100/page)
MUG_MAX_PAGES_ITEM=1                          # stackables: only the cheapest 100 ever sell
MUG_WATCH_ITEM_IDS=                           # optional allowlist of item ids to poll (else all enabled)
MUG_ITEM_VANISH_CONFIRM_POLLS=1
MUG_ITEM_ALERT_ON_REMOVE=false               # items: alert on full removal (ambiguous) — off by default
# Delist guard (DISABLED by default): if >0 and a GEAR seller acted within this many seconds of
# their item vanishing, assume a delist and drop it. We now alert on every vanish (you judge
# delist-vs-sale) and drop the seller↔uid pairing on vanish, so leave this 0.
MUG_DELIST_GUARD_SECONDS=0
# Soft de-list handling (these seed the DB; tune live with /delist). A gear uid that vanishes while
# the seller was online/idle and acted within TAG seconds is a likely self-pull, not a buy.
MUG_DELIST_TAG_SECONDS=120                    # 0 disables the de-list flag
MUG_DELIST_MODE=ping                          # ping (post+ping) | silent (post, no ping) | off (drop)

# ---- Hospital handling (seeds the DB; tune live with /hosplock) ----------------------------
MUG_HOSP_MODE=live                            # live (post now) | remind (post now + re-post) | hold
# Lead time (how early to post/re-post for hold/remind) defaults to 120s and is set via /hosplock.

# ---- Mug history decay ---------------------------------------------------------------------
MUG_CLAIM_ON_ALERT=true                       # once alerted (assumed mugged), don't re-count those sales
MUG_BANK_GRACE_SECONDS=900                    # sale full-value if seller went quiet within this of it
MUG_BANK_ASSUME_SECONDS=21600                 # ...and ~zero once they've been active this long after it
# Mug protection: a freshly-mugged seller (in hospital, "Mugged by …") has a protected wallet that
# decays to 0 over this many hours; we reduce the mug value by the still-protected fraction. 0 off.
MUG_PROTECTION_HOURS=12

# ---- Items deal-finder ---------------------------------------------------------------------
# (ITEM_DEAL_PCT is runtime-only, in the config table; not an env var.)

# ---- Status panel edits (Discord rate limits) ----------------------------------------------
MUG_STATUS_MIN_EDIT_INTERVAL=6                # min seconds between edits of the same message
MUG_STATUS_EDIT_SPACING=1.2                   # seconds between editing each category message

# ---- Rate limiting (Torn keys) -------------------------------------------------------------
MUG_RATE_LIMIT_BACKOFF=60                     # cool a key for this long on a "too many requests"
MUG_RATE_LIMIT_GLOBAL_PAUSE=false             # true = a rate-limit pauses ALL keys, not just one
MUG_API_MAX_KEY_RETRIES=3                     # on a key-specific error, retry immediately on this many other keys (Torn-side/5xx errors don't retry)
# Requests/minute allowed per key before the rotation skips it (Torn's own limit is ~100/min).
# Staying under it ourselves avoids error 5, which parks a key for the backoff above. 0 = disabled.
MUG_KEY_BUDGET_PER_MIN=100

# ---- Raw ingest capture --------------------------------------------------------------------
# Phase 0 discovery aid: dump every ingest POST to scratch/dumps/*.jsonl and the raw_events table.
# OFF by default — the parser exists now, and left on it grows without bound in the same database
# the poller and alert path use. Turn on only to inspect a payload shape.
MUG_RAW_CAPTURE=false
MUG_RAW_RETENTION_DAYS=7                      # raw_events older than this are pruned at startup + daily

# ---- Auction house scraper (ah_scrape.py, run from cron) -----------------------------------
# The AH ledger is a SEPARATE database file, not mug_bot.db. Everything in the bot process
# serialises through one SQLite connection that the alert path also queues on, so a backfill
# writing tens of thousands of rows into the same file would contend directly with alerts.
MUG_AH_DB_PATH=/var/lib/mug-bot/mug_ah.db
MUG_AH_PAGE_LIMIT=100                         # rows per request; Torn caps this at 100
MUG_AH_MAX_PAGES=40                           # requests per FORWARD run (catching up is never big)
# Backfill is bounded by wall clock instead — its length is the thing we are trying to measure, so
# a page cap would mean guessing it. Resumable, so stopping on the budget is not a failure.
# Use `ah_scrape.py backfill --max-seconds 0` for a one-off "download everything" run.
MUG_AH_MAX_SECONDS=1800                       # 30m per backfill run; 0 = unbounded
MUG_AH_OVERLAP_SECONDS=5                      # re-request this much either side of the watermark
MUG_AH_PAGE_DELAY=0.5                         # spacing, so a scrape burst can't starve the poller
# Torn serves some auctions with an epoch-adjacent timestamp — real auction, unusable date. They are
# dropped at ingest: ownership is "most recent wins", so a win that cannot be placed in time is not
# evidence, and storing them breaks MIN(ended_at), which is the backfill's own resume floor.
MUG_AH_MIN_TIMESTAMP=1072915200                # 2004-01-01Z; Torn launched in 2004

# ---- Logging -------------------------------------------------------------------------------
# Level for the bot's own loggers (mug.*): DEBUG | INFO | WARNING | ERROR.
# httpx is always pinned to WARNING — it logs full request URLs, and the Torn key is a query
# parameter, so at INFO it writes live API keys into the journal on every call.
MUG_LOG_LEVEL=INFO

# ---- Debugging -----------------------------------------------------------------------------
MUG_DEBUG_GEAR=false                          # verbose per-uid gear reconcile + /gear capture logs
