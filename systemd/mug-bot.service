# Mug Bot systemd unit. Installed to /etc/systemd/system/mug-bot.service by the .deb
# (packaging/postinst enables + starts it). To run without the package, copy this file there,
# adjust the paths if you deployed somewhere other than /home/monchoon/torn/mug-bot, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now mug-bot
#   journalctl -u mug-bot -f
#
# Inbound TCP 3001 must be open for the browser's GM.xmlHttpRequest POSTs:
#   sudo ufw allow 3001/tcp

[Unit]
Description=Mug Bot (Torn item-market monitor + Discord alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monchoon
WorkingDirectory=/home/monchoon/torn/mug-bot
ExecStart=/home/monchoon/torn/mug-bot/.venv/bin/python main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
